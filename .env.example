# AutoWise AI - Environment Variables Configuration
# Copy this file to .env to customize settings

# Application Environment
DEBUG=false

# Optional AI Explanation LLM Keys
# If neither is provided, AutoWise AI transparently uses its built-in rule-based explanation engine
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto

# Server & Paths
MODEL_PATH=artifacts/model.joblib
REPORT_PATH=artifacts/evaluation_report.json
METADATA_PATH=artifacts/model_metadata.json
FRONTEND_DIST=frontend/dist
